# Copy to .env and fill in. Never commit .env.
# Log format: plain | json
HKGOV_LOG__FORMAT=plain
HKGOV_LOG__FILTER=info,hkgov=debug

# Bind address
HKGOV_API__BIND=0.0.0.0:8080

# Optional HKMA API key for higher upstream quotas.
# HKGOV_UPSTREAM__HKMA_API_KEY=

# Production-critical (see railway.toml). Set ALL of these for a real deploy:
# CORS origins allowed to call the API (your dashboard origin).
# HKGOV_API__CORS_ORIGINS="https://your-dashboard.example"
# Shared API key — empty = anonymous access (dev only; NEVER ship empty to prod).
# HKGOV_API__API_KEY="generate-a-long-random-secret"
# Per-IP inbound request limit. 0 = unlimited (dev only).
# HKGOV_API__RATE_PER_SEC=20
# Enable the background analysis supervisor.
# HKGOV_AGENT__ENABLED=true

# ---- Cloudflare Worker proxy for commercial property portals ----
#
# Required to enable the HKP + Midland connectors (Chung Sen + AA Property
# are direct fetch and need no proxy). Deploy the Worker per
# workers/hkgov-proxy/README.md, then set all three values together:
# HKGOV_UPSTREAM__PROXY_URL="https://hkgov-proxy.<your-sub>.workers.dev"
# HKGOV_UPSTREAM__PROXY_CF_ACCESS_CLIENT_ID="<service-token-id>"
# HKGOV_UPSTREAM__PROXY_CF_ACCESS_CLIENT_SECRET="<service-token-secret>"
